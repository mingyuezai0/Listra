<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- BridgeActivity 在 onCreate 里 setTheme(R.style.AppTheme_NoActionBar)，
         而 app 模块的资源会盖掉 Capacitor 库同名的那份（库那份的 parent 是
         Theme.AppCompat.NoActionBar，深色），所以这一份才是真正生效的主题。
         下面四条全是"让系统那两条栏跟软件的白底薄荷对上"：
         - windowBackground：API 35+ 强制 edge-to-edge 之后，状态栏/导航栏是透明的，
           透出来的是 decorView 的 windowBackground；SystemBars.setStyle() 也会
           把它重设成这个属性（SystemBars.java 里 setBackgroundColor 那行）。
           不改它，深色主题的 #303030 会从顶上透出一条灰边。
         - statusBarColor / navigationBarColor：API 35 以下没有强制 edge-to-edge，
           这两条栏是实心的，默认吃的是主题的 colorPrimaryDark（库里的值是靛蓝
           #303F9F）—— 一条蓝紫色的顶栏，跟软件半点不像。这里改成软件的纸色。
         - windowLightStatusBar：深色图标。默认 false = 浅色图标，白底上看不见。

         ⚠️ parent 不能用 DayNight（第 16 项）。DayNight 会跟着系统深浅走，
            系统开了深色，「播放设置 → 到点」那颗时钟点开的面板就是一块黑的 ——
            而软件本身是固定的白底薄荷，跟不了系统的深浅。钉成 Light。
         ⚠️ colorAccent / colorPrimary / colorControlActivated 三条也不能省：
            网页里那颗 <input type="time"> 点开的是**系统**的时钟面板，它认的是
            主题的强调色。不写就落回 Capacitor 库那份（colorPrimary 靛蓝 #3F51B5、
            colorAccent 品红 #FF4081），弹出来一片蓝紫粉。这里换成薄荷主色。
            窗底 windowBackground 已经是软件那张纸色，面板的白底由 Light 那份
            alertDialogTheme 兜着。 -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">#FFF6FAF8</item>
        <item name="android:statusBarColor">#FFF6FAF8</item>
        <item name="android:navigationBarColor">#FFF6FAF8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="colorPrimary">#FF16C79A</item>
        <item name="colorPrimaryDark">#FF0FA47F</item>
        <item name="colorAccent">#FF16C79A</item>
        <item name="colorControlActivated">#FF16C79A</item>
        <item name="android:colorAccent" tools:targetApi="lollipop">#FF16C79A</item>
        <item name="android:colorControlActivated" tools:targetApi="lollipop">#FF16C79A</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
